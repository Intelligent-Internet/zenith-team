{
  "name": "ii-company",
  "private": true,
  "version": "0.1.8",
  "productName": "Zenith Team",
  "type": "module",
  "main": "electron/main/app.cjs",
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "api:generate": "openapi-typescript ../docs/api/spec/openapi.yaml --output src/shared/api/generated/api.generated.ts",
    "api:lint": "redocly lint ../docs/api/spec/openapi.yaml --config ../docs/api/spec/redocly.yaml",
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "node electron/scripts/build-boardly-binaries.cjs && node electron/scripts/dev.cjs",
    "electron:dev:debug": "node electron/scripts/build-boardly-binaries.cjs && node electron/scripts/dev.cjs",
    "electron:package": "node electron/scripts/clean-output.cjs && node electron/scripts/build-preload.cjs && node electron/scripts/build-boardly-binaries.cjs && node electron/scripts/build-renderer.cjs && node electron/scripts/run-forge.cjs package",
    "electron:make": "node electron/scripts/clean-output.cjs && node electron/scripts/build-preload.cjs && node electron/scripts/build-boardly-binaries.cjs && node electron/scripts/build-renderer.cjs && node electron/scripts/run-forge.cjs make && node electron/scripts/finalize-artifacts.cjs",
    "electron:make:mac:signed": "node electron/scripts/make-signed-macos.cjs",
    "electron:release:assert-version": "node electron/scripts/assert-release-version.cjs",
    "electron:release:merge-upload": "node electron/scripts/merge-release-upload.cjs",
    "electron:release:prepare-upload": "node electron/scripts/prepare-release-upload.cjs",
    "electron:security:scan": "node electron/scripts/security-scan.cjs",
    "test:commerce-kit": "vitest run --config ../server/internal/mcp/tools/testdata/commerce-kit.vitest.config.mjs",
    "lint": "prettier --check package.json \"src/app/shell/**/*.{ts,tsx}\" \"src/features/{agent-setup,approvals,company-plan,notifications,project-canvas}/**/*.{ts,tsx}\" \"src/features/workflows/**/*.{ts,tsx,css}\" \"src/shared/canvas/**/*.{ts,tsx}\" \"src/features/whiteboards/**/*.{ts,tsx,css}\" src/state/slice/workflow-pins.ts src/state/slice/workflow-drafts.ts src/features/scheduled/model/schedule-seed.ts src/features/chat-panel/hooks/use-agent-realtime-chat.ts \"src/features/settings/{components/{computer-handover-dialog,daemon-settings-card,remove-runtime-dialog,rename-runtime-dialog,workflow-app-connect-panel},model/{runtime-management,settings-navigation},routes/{agent-settings-page,runtime-detail-page,settings-hub-page}}.{ts,tsx}\" \"src/shared/api/**/*.{ts,tsx}\" \"src/shared/permissions/**/*.{ts,tsx}\" \"src/shared/realtime/**/*.{ts,tsx}\" \"electron/main/{agent-discovery,agent-verification,app,daemon-environment,daemon-panel,daemon-runtime,desktop-auth-api,desktop-auth-store,ipc,realtime-request-policy,trusted-frame}.{cjs,mjs}\" \"electron/scripts/{build-boardly-binaries,make-signed-macos}.{cjs,mjs}\" electron/preload/index.cjs electron/shared/desktop-variant.cjs forge.config.cjs",
    "typecheck": "tsc --noEmit && pnpm typecheck:commerce-kit",
    "typecheck:commerce-kit": "tsc --noEmit --project ../server/internal/mcp/tools/testdata/tsconfig.commerce-kit.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@reduxjs/toolkit": "^2.8.2",
    "@sentry/electron": "8.1.0",
    "@sentry/react": "11.4.0",
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-collaboration-caret": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/y-tiptap": "3.0.9",
    "@xmldom/xmldom": "0.9.10",
    "@xyflow/react": "^12.8.5",
    "ai": "^5.0.81",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "echarts": "^6.1.0",
    "emoji-picker-react": "4.20.2",
    "exceljs": "4.4.0",
    "fflate": "0.8.2",
    "katex": "0.16.47",
    "livekit-client": "^2.15.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mermaid": "11.17.2",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "nanoid": "^5.1.6",
    "next-themes": "^0.4.6",
    "parse5": "7.3.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.1.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.79.0",
    "react-joyride": "^3.2.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.5.3",
    "react-virtuoso": "4.18.14",
    "recharts": "^3.8.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "rehype-sanitize": "6.0.0",
    "shiki": "3.23.0",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "streamdown": "1.6.11",
    "tailwind-merge": "^3.3.1",
    "use-stick-to-bottom": "^1.1.1",
    "use-sync-external-store": "1.6.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@redocly/cli": "2.45.0",
    "@sentry/vite-plugin": "5.4.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/hast": "3.0.5",
    "@types/katex": "0.16.7",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.7.9",
    "esbuild": "0.25.12",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "katex": "$katex",
      "mermaid": "$mermaid"
    }
  }
}
