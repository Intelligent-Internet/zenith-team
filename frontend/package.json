{
  "name": "zenith-team",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "productName": "Zenith Team",
  "type": "module",
  "main": "electron/main/app.cjs",
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "api:generate": "openapi-typescript ../docs/api/spec/openapi.yaml --output src/shared/api/generated/api.generated.ts",
    "api:lint": "redocly lint ../docs/api/spec/openapi.yaml --config ../docs/api/spec/redocly.yaml",
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "node electron/scripts/build-zenith-team-binaries.cjs && node electron/scripts/dev.cjs",
    "electron:dev:debug": "node electron/scripts/build-zenith-team-binaries.cjs && node electron/scripts/dev.cjs",
    "electron:package": "node electron/scripts/clean-output.cjs && node electron/scripts/build-preload.cjs && node electron/scripts/build-zenith-team-binaries.cjs && node electron/scripts/build-renderer.cjs && node electron/scripts/run-forge.cjs package",
    "electron:make": "node electron/scripts/clean-output.cjs && node electron/scripts/build-preload.cjs && node electron/scripts/build-zenith-team-binaries.cjs && node electron/scripts/build-renderer.cjs && node electron/scripts/run-forge.cjs make && node electron/scripts/finalize-artifacts.cjs",
    "electron:make:mac:signed": "node electron/scripts/make-signed-macos.cjs",
    "electron:release:assert-version": "node electron/scripts/assert-release-version.cjs",
    "electron:security:scan": "node electron/scripts/security-scan.cjs",
    "lint": "pnpm check:dependencies && pnpm lint:format",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint:format": "prettier --check package.json \"src/app/shell/**/*.{ts,tsx}\" \"src/features/{agent-setup,approvals,company-plan,notifications,project-canvas}/**/*.{ts,tsx}\" \"src/features/workflows/**/*.{ts,tsx,css}\" \"src/shared/canvas/**/*.{ts,tsx}\" \"src/features/whiteboards/**/*.{ts,tsx,css}\" src/state/slice/workflow-pins.ts src/state/slice/workflow-drafts.ts src/features/scheduled/model/schedule-seed.ts src/features/chat-panel/hooks/use-agent-realtime-chat.ts \"src/features/settings/{components/{computer-handover-dialog,daemon-settings-card,remove-runtime-dialog,rename-runtime-dialog,workflow-app-connect-panel},model/{runtime-management,settings-navigation},routes/{agent-settings-page,runtime-detail-page,settings-hub-page}}.{ts,tsx}\" \"src/shared/api/**/*.{ts,tsx}\" \"src/shared/permissions/**/*.{ts,tsx}\" \"src/shared/realtime/**/*.{ts,tsx}\" \"electron/main/{agent-discovery,agent-verification,app,daemon-environment,daemon-panel,daemon-runtime,desktop-auth-api,desktop-auth-store,ipc,realtime-request-policy,trusted-frame}.{cjs,mjs}\" \"electron/scripts/{build-zenith-team-binaries,make-signed-macos}.{cjs,mjs}\" electron/preload/index.cjs electron/shared/desktop-variant.cjs forge.config.cjs scripts/check-dependencies.mjs \"src/shared/{session,desktop}/**/*.{ts,tsx}\" \"src/features/chat-panel/{api,model}/agent-chat-*.ts\" electron/shared/desktop-bridge.types.ts",
    "check:dependencies": "node scripts/check-dependencies.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/electron": "8.2.0",
    "@sentry/react": "11.7.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "@xmldom/xmldom": "0.9.12",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.140",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "echarts": "^6.1.0",
    "emoji-picker-react": "4.20.2",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "katex": "0.19.0",
    "livekit-client": "^2.22.4",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "mermaid": "12.2.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-joyride": "^3.2.0",
    "react-redux": "^9.2.0",
    "react-router": "^8.4.0",
    "react-virtuoso": "4.18.19",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "rehype-sanitize": "6.0.0",
    "shiki": "4.5.0",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.8",
    "streamdown": "1.6.11",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.1",
    "use-sync-external-store": "1.7.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@redocly/cli": "2.63.0",
    "@sentry/vite-plugin": "11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "3.0.5",
    "@types/katex": "0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-svgr": "^5.2.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "katex": "$katex",
      "mermaid": "$mermaid",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "browserslist": "^4.28.7",
      "fast-uri@^3": "^3.1.9",
      "follow-redirects": "^1.16.1",
      "image-size": "^2.0.4",
      "js-yaml@^4": "^4.3.2",
      "source-map-js": "^1.2.2"
    },
    "patchedDependencies": {
      "appdmg@0.6.6": "patches/appdmg@0.6.6.patch"
    }
  }
}
