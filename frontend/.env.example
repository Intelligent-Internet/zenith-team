ZENITH_TEAM_DESKTOP_ENV=local
ZENITH_TEAM_DESKTOP_API_BASE_URL=http://localhost:8788/api/v1
ZENITH_TEAM_GOOGLE_OAUTH_LOOPBACK_PORT=42813
VITE_API_URL=http://localhost:8788
# Optional public LiveKit URL for lobby DNS/TLS warm-up; never put API secrets here.
# VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Optional desktop error and native crash reporting. The DSN is public;
# use a separate Sentry project for each deployed environment.
ZENITH_TEAM_DESKTOP_CRASH_REPORTS_ENABLED=false
# ZENITH_TEAM_DESKTOP_CRASH_REPORT_PROVIDER=sentry
# ZENITH_TEAM_DESKTOP_SENTRY_DSN=https://public-key@your-ingest-host/project-id

# Optional source-map upload during desktop builds. Keep the auth token in
# the shell or a GitHub environment secret; it is never renderer configuration.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project

# --- Deployment settings (all optional; leave empty for a self-hosted build) ---
# The public marketing site and its /privacy and /terms pages. Empty: the web
# root opens the app and no legal links are shown.
# VITE_ZENITH_TEAM_PUBLIC_SITE_ORIGIN=https://zenith.example.com
# Support address shown in Settings > Support.
# VITE_ZENITH_TEAM_SUPPORT_EMAIL=support@example.com
# Where desktop share links point; defaults to the API origin.
# VITE_ZENITH_TEAM_WEB_APP_ORIGIN=https://zenith.example.com

# --- Desktop cloud builds (dev and prod variants) ---
# Required for dev and prod desktop builds; local builds use 127.0.0.1:8788.
# ZENITH_TEAM_DESKTOP_DEV_ORIGIN=https://api-dev.example.com
# ZENITH_TEAM_DESKTOP_PROD_ORIGIN=https://api.example.com
# Optional Zenith Studio origin and the media hosts its assets load from.
# ZENITH_STUDIO_API_URL=https://studio.example.com
# ZENITH_STUDIO_MEDIA_ORIGINS=https://storage.googleapis.com
