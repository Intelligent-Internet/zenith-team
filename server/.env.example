# Copy this file to server/.env and fill in local-only secrets.
# server/.env is ignored by git.
#
# Every value below is read by server/internal/config. Uncommented lines are a
# working local setup against a native PostgreSQL; commented lines show the
# default the server uses when the variable is unset. Empty behaves as unset.
#
# The daemon (`zen daemon start`) is configured separately through
# BOARDLY_* variables — see the end of this file.

# --- Required ---------------------------------------------------------------
APP_DATABASE_URL='postgresql://boardly:boardly@localhost:5432/boardly?sslmode=disable'
APP_REDIS_URL='redis://localhost:6379/0'
# Signs CSRF, session, and run capability tokens. At least 32 bytes.
# Rotating it invalidates all three at once.
AUTH_CSRF_SECRET='development-only-32-byte-secret!'

# --- Application ------------------------------------------------------------
APP_NAME='Boardly API'
APP_ENVIRONMENT='local'
# Studio endpoint distributed to daemons at startup; credentials stay on each user's machine.
# ZENITH_STUDIO_API_URL='https://api-agent.ii.inc'
# For a local Studio API: ZENITH_STUDIO_API_URL='http://localhost:8000'
# APP_HTTP_ADDR=':8788'
# APP_LOG_LEVEL='info'                      # debug | info | warn | error
# APP_SHUTDOWN_TIMEOUT_SECONDS='15'         # graceful drain budget
# Every replica shares PostgreSQL, Redis and the configured object store.
# APP_API_REPLICAS='1'
# Redis is required for Schedules, realtime fanout and the claim-empty cache.
# Use AOF everysec, noeviction, and a separate DB index per environment.
# APP_SCHEDULE_WORKERS='8'                  # 1..64, at most DB pool max / 3
# APP_SCHEDULE_SWEEP_SECONDS='30'           # 10..60; repairs without Redis
# Bearer token guarding /health/realtime for non-loopback readers.
# APP_REALTIME_METRICS_TOKEN=''

# --- PostgreSQL pool --------------------------------------------------------
# APP_DATABASE_MAX_CONNS='25'
# APP_DATABASE_MIN_CONNS='5'                # must not exceed max
# APP_DATABASE_MAX_CONN_LIFETIME_SECONDS='3600'
# APP_DATABASE_MAX_CONN_IDLE_TIME_SECONDS='1800'
# APP_DATABASE_HEALTH_CHECK_PERIOD_SECONDS='60'

# --- Browser origins and cookies --------------------------------------------
AUTH_WEB_ORIGINS='http://localhost:5173,http://127.0.0.1:5173'
AUTH_WEB_APP_ORIGIN='http://localhost:5173'
# Derived from the configured origins. Any HTTPS origin forces true; it cannot
# be overridden back to false.
# AUTH_COOKIE_SECURE='false'
# Comma-separated CIDRs whose X-Forwarded-Host is trusted for the WebSocket
# origin check. Empty trusts nobody — set this when running behind a proxy.
# BOARDLY_TRUSTED_PROXIES=''

# --- Sessions ---------------------------------------------------------------
# AUTH_ACCESS_TOKEN_TTL_SECONDS='900'       # 15 minutes
# AUTH_REFRESH_TOKEN_TTL_SECONDS='604800'   # 7 days; must exceed the access TTL
# AUTH_DESKTOP_HANDOFF_CODE_TTL_SECONDS='60'  # range 10..300

# --- Email verification and password reset (optional) -----------------------
# Leave the provider, API key, and verification secret empty to keep the
# immediate-signup development flow. Configuring all three enables the 6-digit
# OTP before signup completes, plus password recovery.
AUTH_RESEND_API_KEY=''
AUTH_EMAIL_VERIFICATION_SECRET=''
# AUTH_EMAIL_PROVIDER='resend'
# AUTH_EMAIL_PROVIDER_TIMEOUT_SECONDS='10'  # range 1..30
# The published Boardly templates are the defaults; override only when testing
# different ones.
# AUTH_EMAIL_VERIFICATION_TEMPLATE_ID='00000000-0000-4000-8000-000000000001'
# AUTH_EMAIL_VERIFICATION_TTL_SECONDS='600'            # range 60..1800
# AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS='60' # range 10..600, < TTL
# AUTH_PASSWORD_RESET_TEMPLATE_ID='00000000-0000-4000-8000-000000000002'
# AUTH_PASSWORD_RESET_TTL_SECONDS='1800'               # range 300..86400
# AUTH_PASSWORD_RESET_RESEND_COOLDOWN_SECONDS='60'     # range 10..600, < TTL

# --- Company mailbox (optional; dedicated Resend credentials) ---------------
# Configure the API key and domain together. The webhook secret may be added
# after Resend creates the receiving endpoint.
# MAILBOX_RESEND_API_KEY=''
# MAILBOX_RESEND_WEBHOOK_SECRET=''
# MAILBOX_DOMAIN='mail.boardly.example'
# MAILBOX_REQUESTS_PER_SECOND='4'         # range 1..5
# MAILBOX_PROVIDER_TIMEOUT_SECONDS='10'   # range 1..30

# --- Google OAuth (optional; Web group, Desktop pair, or both) --------------
# When both are configured their client IDs must differ.
# GOOGLE_WEB_CLIENT_ID='<from Google Cloud console>'
# GOOGLE_WEB_CLIENT_SECRET='<local secret>'
# GOOGLE_WEB_REDIRECT_URI='http://localhost:8788/api/v1/auth/google/web/callback'
# GOOGLE_DESKTOP_CLIENT_ID='<from Google Cloud console>'
# GOOGLE_DESKTOP_CLIENT_SECRET='<local secret>'
# GOOGLE_OAUTH_FLOW_TTL_SECONDS='600'          # range 60..900
# GOOGLE_OAUTH_PROVIDER_TIMEOUT_SECONDS='10'   # range 1..30

# --- Attachment storage -----------------------------------------------------
# Local mode uses the Silo service and bucket created by make infra-up.
# Requires APP_ENVIRONMENT=local. Use s3 for explicit deployment configuration.
STORAGE_DRIVER='local'
# Optional overrides for the local Silo defaults:
# STORAGE_S3_BUCKET='boardly-attachments'
# STORAGE_S3_REGION='us-east-1'
# STORAGE_S3_ENDPOINT='http://localhost:9000' # omit for AWS S3 with STORAGE_DRIVER=s3
# STORAGE_S3_ACCESS_KEY_ID='boardly'
# STORAGE_S3_SECRET_ACCESS_KEY='boardly-development-secret'
# STORAGE_S3_SESSION_TOKEN=''             # temporary credentials only
# STORAGE_S3_USE_PATH_STYLE='true'        # defaults to false with STORAGE_DRIVER=s3

# --- Attachments ------------------------------------------------------------
# How long a completed-but-unlinked upload survives before reclamation.
# ATTACHMENT_ABANDONED_READY_GRACE_SECONDS='86400'   # range 3600..2592000

# --- Huddles and voice Agents (optional; docs/huddles-local.md) ------------
# HUDDLES_ENABLED defaults to true; false turns Huddles off even with LiveKit.
# HUDDLES_ENABLED='true'
# Local LiveKit (`make livekit-up`) and the local voice worker. For LiveKit
# Cloud, use the project's URL, API key and secret instead.
# LIVEKIT_URL='http://127.0.0.1:7880'
# LIVEKIT_API_KEY='devkey'
# LIVEKIT_API_SECRET='development-only-livekit-api-secret'
# Enables both conversational voice Agents and independent AI notes.
# HUDDLE_AI_ENABLED='true'
# HUDDLE_AI_WORKLOAD_SECRET='development-only-huddle-ai-workload-secret'

# --- Output publication to Google Cloud Run (optional) ----------------------
# GCP_PROJECT_ID='my-project'
# GCP_REGION='us-central1'
# GCP_SOURCE_BUCKET='my-project-app-sources'
# GCP_ARTIFACT_REGISTRY='us-central1-docker.pkg.dev/my-project/user-apps'
# GCP_SERVICE_ACCOUNT_EMAIL='boardly-build@my-project.iam.gserviceaccount.com'
# CLOUD_RUN_SERVICE_ACCOUNT='boardly-runtime@my-project.iam.gserviceaccount.com'
# CLOUD_RUN_MAX_INSTANCES='10'
# CLOUD_RUN_MIN_INSTANCES='0'
# CLOUD_RUN_MEMORY='512Mi'
# CLOUD_RUN_CPU='1'

# --- Daemon (`zen daemon start`) ----------------------------------------
# The daemon runs on the user's machine and takes its own BOARDLY_* variables;
# it does NOT read this file. Every one has a flag on `zen daemon start`
# except where noted. Listed here so the whole surface lives in one place.
#
#   BOARDLY_SERVER_URL              http://localhost:8080
#   BOARDLY_HOME                    $HOME/.boardly  (auth.json, daemon.id,
#                                   config.json, daemon.log)
#   BOARDLY_DAEMON_ID               persisted on first run
#   BOARDLY_DEVICE_NAME             hostname
#   BOARDLY_COMPANY_ID              from config.json
#   BOARDLY_HEALTH_PORT             19713            (no flag)
#   BOARDLY_POLL_INTERVAL           30s
#   BOARDLY_HEARTBEAT_INTERVAL      15s
#   BOARDLY_MAX_CONCURRENT_RUNS     20
#   BOARDLY_AGENT_TIMEOUT           0 (no cap)
#   BOARDLY_AGENT_IDLE_WATCHDOG     30m, 0 disables  (no flag)
#   BOARDLY_AGENT_TOOL_WATCHDOG     2h,  0 disables  (no flag)
#   BOARDLY_WORKSPACES_ROOT         $HOME/boardly_workspaces
#   BOARDLY_GC_ENABLED              true             (only "false" disables)
#   BOARDLY_GC_INTERVAL             2h               (no flag)
#   BOARDLY_CONNECTOR_DISCOVERY_INTERVAL  3m, clamped to 1m–3m30s  (no flag)
#                                   how often Connector discovery is
#                                   re-observed so Runs keep their apps
#   BOARDLY_CLAUDE_PATH             resolved from PATH
#   BOARDLY_CODEX_PATH              newest codex on PATH, in ~/.codex/packages
#                                   or the macOS app; set it to pin one copy
#   BOARDLY_CLAUDE_ARGS             extra args, shell-word parsed
#   BOARDLY_CODEX_ARGS              extra args, shell-word parsed
#   BOARDLY_CLAUDE_MODEL            provider default
#   BOARDLY_CODEX_MODEL             provider default
#   BOARDLY_CODEX_HANDSHAKE_TIMEOUT       30s
#   BOARDLY_CODEX_SEMANTIC_INACTIVITY     10m
#   BOARDLY_CODEX_MEMORY            operator escape hatch
#   BOARDLY_CODEX_MULTI_AGENT       operator escape hatch
#   BOARDLY_MCP_EXECUTABLE          empty disables the boardly MCP server
#
# `zen config show` prints the resolved values.

# --- Custom publication URLs via Cloudflare Workers KV (optional) ---
# Configure all four values together. The Worker routes <name>.<base-domain>.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_BASE_DOMAIN=

# Optional published Resend invitation template. Without it, Invite is disabled.
# Variables: COMPANY_NAME, INVITER_NAME, INVITATION_URL, EXPIRES_AT.
AUTH_INVITATION_TEMPLATE_ID=

# --- Personal social connections (optional) ----------------------------------
# Calendar works without these. X is released first; other implemented adapters
# stay Coming soon unless explicitly enabled for an approved app/test account.
# See docs/specs/calendar/TECH.md for exact callback URLs and required scopes.
# SOCIAL_ENABLED_PLATFORMS='x'
# SOCIAL_CALLBACK_ORIGIN='http://localhost:8788'
# Dedicated AES-256 key: openssl rand -base64 32. Back it up; do not rotate without
# migrating credentials or requiring users to reconnect. Never commit a real key.
# SOCIAL_TOKEN_ENCRYPTION_KEY=''
# SOCIAL_X_CLIENT_ID=''
# SOCIAL_X_CLIENT_SECRET=''
# SOCIAL_FACEBOOK_CLIENT_ID=''
# SOCIAL_FACEBOOK_CLIENT_SECRET=''
# SOCIAL_INSTAGRAM_CLIENT_ID=''
# SOCIAL_INSTAGRAM_CLIENT_SECRET=''
# SOCIAL_LINKEDIN_CLIENT_ID=''
# SOCIAL_LINKEDIN_CLIENT_SECRET=''
# SOCIAL_META_GRAPH_VERSION='v23.0'
