# Local voice worker configuration. `make voice-setup` copies this file to
# voice-agent/.env (ignored by git); then set OPENAI_API_KEY there.
# Every value except OPENAI_API_KEY matches docker/dev.env and the local
# LiveKit config, so `make server` + `make livekit-up` work unchanged.

# Local LiveKit (docker/livekit.docker.yaml or docker/livekit.dev.yaml).
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=development-only-livekit-api-secret

# Your own OpenAI key. The project needs access to gpt-live-1; real calls
# spend from it, capped by the Company AI budget you set in the app.
OPENAI_API_KEY=

# The local Go API (`make server`) and its development workload secret.
ZENITH_API_URL=http://127.0.0.1:8788
HUDDLE_AI_WORKLOAD_SECRET=development-only-huddle-ai-workload-secret
