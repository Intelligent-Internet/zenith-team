#!/bin/sh
# Before a push: checks every pushed branch name and the subject of every new
# commit on it (see conventions.sh), which also catches commits made with
# --no-verify or by tools that skip hooks. Tags and deletions pass.
# Install with `make hooks`; bypass once with `git push --no-verify`.
. "$(dirname "$0")/conventions.sh"

remote="$1"
zero=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
    *) continue ;;
  esac
  [ "$local_sha" = "$zero" ] && continue

  check_branch "$branch" || status=1

  # New commits only: the whole branch when the remote does not have it yet.
  if [ "$remote_sha" = "$zero" ]; then
    commits="$(git rev-list --no-merges "$local_sha" --not --remotes="$remote")"
  else
    commits="$(git rev-list --no-merges "$remote_sha..$local_sha")"
  fi
  for commit in $commits; do
    subject="$(git log -1 --format=%s "$commit")"
    check_subject "$subject" 2>/dev/null || {
      echo "pre-push: $(git log -1 --format=%h "$commit") \"$subject\" is not a Conventional Commit subject." >&2
      status=1
    }
  done
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: push refused. Fix commit subjects with git commit --amend or git rebase -i." >&2
fi
exit "$status"
