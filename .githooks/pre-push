#!/bin/sh
# Checks the name of every branch pushed: `type/short-name`, lowercase, for
# example `fix/daemon-first-claim` or `docs/self-hosting-tls`. Tags and main
# pass. Install with `make hooks`; bypass once with `git push --no-verify`.
types='feat|fix|docs|refactor|perf|test|build|ci|chore|revert|security|release'
status=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
    *) continue ;;
  esac
  [ "$branch" = "main" ] && continue
  if ! printf '%s\n' "$branch" | grep -Eq "^($types)/[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*$"; then
    echo "pre-push: name branches type/short-name, for example fix/daemon-first-claim." >&2
    echo "Types: $(printf '%s' "$types" | tr '|' ' '). Got: $branch" >&2
    status=1
  fi
done

exit "$status"
