#!/bin/sh
# Scans the staged changes for secrets with gitleaks and .gitleaks.toml, when
# gitleaks is installed (https://github.com/gitleaks/gitleaks). GitHub secret
# scanning and push protection check again on push.
# Install with `make hooks`; bypass once with `git commit --no-verify`.
command -v gitleaks >/dev/null 2>&1 || exit 0
exec gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
