#!/bin/sh
# Checks the commit subject (see conventions.sh). Git hands the message only to
# this hook, so the check lives here; pre-push checks every pushed commit again.
# Install with `make hooks`; bypass once with `git commit --no-verify`.
. "$(dirname "$0")/conventions.sh"

subject="$(sed -n '/^[[:space:]]*#/d;/^[[:space:]]*$/d;p;q' "$1")"
check_subject "$subject" || { echo "commit-msg: commit refused." >&2; exit 1; }
