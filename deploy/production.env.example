# Zenith Team production environment template.
#
# Copy to `.env` in this directory (docker compose reads it automatically for
# deploy/docker-compose.production.yml) and fill in every <...> placeholder.
# Inject real secrets from your secret manager; never commit a filled file.

# --- Required ---------------------------------------------------------------

# Password for the bundled PostgreSQL service. If it ever contains characters
# that are not URL-safe, set APP_DATABASE_URL explicitly with the
# password percent-encoded.
APP_POSTGRES_PASSWORD=<generate: openssl rand -hex 24>

# At least 32 bytes. Signs CSRF, session, and Run capability tokens; rotating
# it invalidates outstanding tokens of all three kinds.
AUTH_CSRF_SECRET=<generate: openssl rand -hex 32>

# Exact canonical renderer origins, comma separated. HTTPS is required outside
# loopback development and forces Secure cookies. The packaged Electron origin
# is fixed and must remain an exact match; never replace it with null or *.
AUTH_WEB_ORIGINS=https://app.example.com,boardly-app://renderer

# --- Common -----------------------------------------------------------------

# Service identity for logs and health metadata.
#APP_NAME=Zenith Team API
#APP_ENVIRONMENT=production

# Host port the API publishes on (container always listens on 8788).
#APP_HTTP_PORT=8788

# Required whenever email verification or Google OAuth is enabled; must also
# appear in AUTH_WEB_ORIGINS.
AUTH_WEB_APP_ORIGIN=https://app.example.com

# How long a desktop browser sign-in handoff code stays valid before it must
# be re-minted. Bounded server-side to 10-300 seconds.
#AUTH_DESKTOP_HANDOFF_CODE_TTL_SECONDS=60

# External database/Redis instead of the bundled services.
# Redis is required; Compose already connects to the bundled Redis by default.
# URLs containing credentials are secrets: keep them in .env or a secret manager.
#APP_DATABASE_URL=postgresql://boardly:<password>@db.internal:5432/boardly
#APP_REDIS_URL=redis://redis.internal:6379/0

# Prebuilt image reference instead of building from source.
#APP_SERVER_IMAGE=registry.example.com/boardly-server:v1.0.0

# Scheduler workers, sweep interval, DB pool and Redis memory are ordinary
# configuration in docker-compose.production.yml. No scheduler secret is needed.

# --- Email verification (all core values together, or none) -----------------

#AUTH_EMAIL_PROVIDER=resend
#AUTH_RESEND_API_KEY=<inject from secret manager>
#AUTH_EMAIL_VERIFICATION_SECRET=<generate: openssl rand -hex 32>
#AUTH_EMAIL_VERIFICATION_TEMPLATE_ID=00000000-0000-4000-8000-000000000001
#AUTH_EMAIL_VERIFICATION_TTL_SECONDS=600
#AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
#AUTH_EMAIL_PROVIDER_TIMEOUT_SECONDS=10
#AUTH_PASSWORD_RESET_TEMPLATE_ID=00000000-0000-4000-8000-000000000002
#AUTH_PASSWORD_RESET_TTL_SECONDS=1800
#AUTH_PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# --- Company mailbox (dedicated Resend credentials) -------------------------

#MAILBOX_RESEND_API_KEY=<inject from secret manager>
#MAILBOX_RESEND_WEBHOOK_SECRET=<from the Resend receiving endpoint>
#MAILBOX_DOMAIN=mail.example.com
#MAILBOX_REQUESTS_PER_SECOND=4
#MAILBOX_PROVIDER_TIMEOUT_SECONDS=10

# --- Attachment storage (S3-compatible; required) -----------------------------

STORAGE_DRIVER=s3
#STORAGE_S3_ENDPOINT=https://s3.example.com
#STORAGE_S3_REGION=us-east-1
#STORAGE_S3_BUCKET=boardly-attachments
#STORAGE_S3_ACCESS_KEY_ID=<inject from secret manager>
#STORAGE_S3_SECRET_ACCESS_KEY=<inject from secret manager>
#STORAGE_S3_USE_PATH_STYLE=false
#ATTACHMENT_ABANDONED_READY_GRACE_SECONDS=86400

# --- Output publication to Google Cloud Run (optional) -----------------------

# Setting GCP_PROJECT_ID enables publication only when both dedicated service
# account identifiers are also set. These names intentionally match the
# reference architecture so its non-secret deployment values can be reused. Use
# ambient Application Default Credentials or inject the Zenith Team server
# credential externally.
#GCP_PROJECT_ID=boardly-production
#GCP_REGION=asia-southeast1
#GCP_SOURCE_BUCKET=boardly-app-sources
#GCP_ARTIFACT_REGISTRY=asia-southeast1-docker.pkg.dev/boardly-production/user-apps
#GCP_SERVICE_ACCOUNT_EMAIL=<required dedicated Cloud Build service account email>
#CLOUD_RUN_SERVICE_ACCOUNT=<required dedicated app runtime service account email>
#CLOUD_RUN_MAX_INSTANCES=10
#CLOUD_RUN_MIN_INSTANCES=0
#CLOUD_RUN_MEMORY=512Mi
#CLOUD_RUN_CPU=1

# --- Google OAuth (configure Web, Desktop, or both) ---------------------------

#GOOGLE_WEB_CLIENT_ID=<from Google Cloud console>
#GOOGLE_WEB_CLIENT_SECRET=<inject from secret manager>
#GOOGLE_WEB_REDIRECT_URI=https://api.example.com/api/v1/auth/google/web/callback
#GOOGLE_DESKTOP_CLIENT_ID=<from Google Cloud console; must differ when web is configured>
#GOOGLE_DESKTOP_CLIENT_SECRET=<inject from secret manager>

# --- Personal social connections (optional) ----------------------------------
# Use a dedicated Zenith Team provider app. Keep the X app separate from other
# products so its callback, scopes and revocation are independent.
#SOCIAL_ENABLED_PLATFORMS=x
#SOCIAL_CALLBACK_ORIGIN=https://app.example.com
#SOCIAL_TOKEN_ENCRYPTION_KEY=<inject stable base64-encoded 32-byte key from secret manager>
#SOCIAL_X_CLIENT_ID=<Zenith Team X OAuth 2 client ID>
#SOCIAL_X_CLIENT_SECRET=<inject from secret manager>
# Keep these disabled until each provider app is ready for its intended users.
#SOCIAL_FACEBOOK_CLIENT_ID=<Meta Facebook app ID>
#SOCIAL_FACEBOOK_CLIENT_SECRET=<inject from secret manager>
#SOCIAL_INSTAGRAM_CLIENT_ID=<Instagram app ID>
#SOCIAL_INSTAGRAM_CLIENT_SECRET=<inject from secret manager>
#SOCIAL_LINKEDIN_CLIENT_ID=<LinkedIn client ID>
#SOCIAL_LINKEDIN_CLIENT_SECRET=<inject from secret manager>
#SOCIAL_META_GRAPH_VERSION=v23.0

# --- Reverse proxy ------------------------------------------------------------

# Canonical CIDRs of the proxies whose X-Forwarded-Host is trusted for the
# WebSocket origin check, e.g. 10.0.0.0/8 for an internal load balancer.
# Empty trusts nobody.
#BOARDLY_TRUSTED_PROXIES=10.0.0.0/8

# --- Custom publication URLs via Cloudflare Workers KV (optional) ---
# Configure all four values together. The Worker routes <name>.<base-domain>.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_BASE_DOMAIN=

# Optional published Resend invitation template. Without it, Invite is disabled.
# Variables: COMPANY_NAME, INVITER_NAME, INVITATION_URL, EXPIRES_AT.
AUTH_INVITATION_TEMPLATE_ID=
