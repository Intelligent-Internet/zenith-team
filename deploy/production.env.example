# Zenith Team self-hosted environment.
#
# `make selfhost-env` copies this file to deploy/.env and fills every value
# marked "generated". Docker Compose reads deploy/.env for
# deploy/docker-compose.production.yml. Never commit a filled-in file.
#
# Markers:
#   REQUIRED    the stack refuses to start without it
#   Secret      keep it out of git and logs; store it in a secret manager
#   Optional    leave it empty to keep the feature off
#
# The full reference is docs/content/docs/self-hosting/environment-variables.mdx.

# --- Required ---------------------------------------------------------------

# REQUIRED. Secret, generated. Password for the bundled PostgreSQL service.
# openssl rand -hex 24
APP_POSTGRES_PASSWORD=

# REQUIRED. Secret, generated. At least 32 bytes. Signs CSRF, session, and Run
# capability tokens; rotating it signs everyone out. The server refuses to
# start in production with a value copied from a template.
# openssl rand -hex 32
AUTH_CSRF_SECRET=

# REQUIRED. Secret, generated. Password for the bundled S3-compatible storage
# (or your own S3 secret key when STORAGE_S3_ENDPOINT points elsewhere).
# openssl rand -hex 32
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Where people open Zenith Team -------------------------------------------

# Exact browser origins, comma separated. HTTPS is required for anything other
# than localhost and turns on Secure cookies. Keep zenith-team-app://renderer
# so the desktop app can sign in.
#AUTH_WEB_ORIGINS=https://zenith.example.com,zenith-team-app://renderer

# The web app's origin; must be one of AUTH_WEB_ORIGINS. Used in email links
# and Google sign-in.
#AUTH_WEB_APP_ORIGIN=https://zenith.example.com

# Host address and ports Docker publishes on. 127.0.0.1 keeps them private to
# this machine; put a TLS reverse proxy in front for remote access.
#APP_BIND_ADDRESS=127.0.0.1
#APP_WEB_PORT=8080
#APP_HTTP_PORT=8788

# Proxies whose X-Forwarded-Host is trusted for the WebSocket origin check,
# as CIDRs (for example 10.0.0.0/8). Empty trusts nobody.
#ZENITH_TEAM_TRUSTED_PROXIES=

# --- Process ----------------------------------------------------------------

#APP_NAME=Zenith Team API
#APP_ENVIRONMENT=production
#APP_LOG_LEVEL=info

# Prebuilt images instead of building from source.
#APP_SERVER_IMAGE=ghcr.io/intelligent-internet/zenith-team-server:latest
#APP_WEB_IMAGE=ghcr.io/intelligent-internet/zenith-team-web:latest

# External PostgreSQL or Redis instead of the bundled services. Redis is
# required; Compose connects to the bundled Redis by default. URLs that carry
# credentials are secrets.
#APP_DATABASE_URL=postgresql://zenith_team:<password>@db.example.com:5432/zenith_team
#APP_REDIS_URL=redis://redis.example.com:6379/0

# How long a desktop browser sign-in handoff code stays valid (10-300 s).
#AUTH_DESKTOP_HANDOFF_CODE_TTL_SECONDS=60

# --- Attachment storage (S3-compatible) -------------------------------------

# The bundled storage service is used unless STORAGE_S3_ENDPOINT points at
# another S3 service. Share links need an endpoint people can reach.
#STORAGE_S3_ENDPOINT=https://s3.example.com
#STORAGE_S3_REGION=us-east-1
#STORAGE_S3_BUCKET=zenith-team-attachments
#STORAGE_S3_ACCESS_KEY_ID=zenith-team
#STORAGE_S3_USE_PATH_STYLE=true
#ATTACHMENT_ABANDONED_READY_GRACE_SECONDS=86400

# --- Email: sign-up codes, password reset, invitations (Optional) -----------

# Without email, sign-up completes immediately. Turning it on needs a Resend
# account and templates created from docs/branding/emails.
#AUTH_EMAIL_PROVIDER=resend
# Secret.
#AUTH_RESEND_API_KEY=
# Secret. openssl rand -hex 32
#AUTH_EMAIL_VERIFICATION_SECRET=
# REQUIRED when email is on: your Resend template IDs.
#AUTH_EMAIL_VERIFICATION_TEMPLATE_ID=
#AUTH_PASSWORD_RESET_TEMPLATE_ID=
# Optional: turns invitation emails on.
#AUTH_INVITATION_TEMPLATE_ID=
#AUTH_EMAIL_VERIFICATION_TTL_SECONDS=600
#AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
#AUTH_EMAIL_PROVIDER_TIMEOUT_SECONDS=10
#AUTH_PASSWORD_RESET_TTL_SECONDS=1800
#AUTH_PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# --- Google sign-in (Optional; Web, Desktop, or both) -----------------------

#GOOGLE_WEB_CLIENT_ID=
# Secret.
#GOOGLE_WEB_CLIENT_SECRET=
#GOOGLE_WEB_REDIRECT_URI=https://zenith.example.com/api/v1/auth/google/web/callback
# Must differ from the web client when both are set.
#GOOGLE_DESKTOP_CLIENT_ID=
# Secret.
#GOOGLE_DESKTOP_CLIENT_SECRET=

# --- Company mailbox (Optional; dedicated Resend credentials) ---------------

# Secret.
#MAILBOX_RESEND_API_KEY=
# Secret. From the Resend receiving endpoint.
#MAILBOX_RESEND_WEBHOOK_SECRET=
#MAILBOX_DOMAIN=mail.example.com
#MAILBOX_REQUESTS_PER_SECOND=4
#MAILBOX_PROVIDER_TIMEOUT_SECONDS=10

# --- Huddles: voice rooms and the AI voice worker (Optional) ----------------

# Huddles need a LiveKit server. HUDDLES_ENABLED=false turns them off even when
# LiveKit is configured.
#HUDDLES_ENABLED=true
#LIVEKIT_URL=wss://your-project.livekit.cloud
#LIVEKIT_API_KEY=
# Secret.
#LIVEKIT_API_SECRET=
# AI voice needs the LiveKit values above and a shared secret of at least 32
# bytes with the voice worker (voice-agent/).
#HUDDLE_AI_ENABLED=false
# Secret. openssl rand -hex 32
#HUDDLE_AI_WORKLOAD_SECRET=
# Optional recaps of independent Huddle notes, made by the server through the
# OpenAI Responses API. Set both; the model must support JSON output.
# Secret.
#HUDDLE_NOTES_RECAP_API_KEY=
#HUDDLE_NOTES_RECAP_MODEL=

# --- Zenith Studio (Optional) -----------------------------------------------

# The Zenith Studio API origin. Empty keeps Studio tools off.
#ZENITH_STUDIO_API_URL=https://studio.example.com

# --- Publish outputs to Google Cloud Run (Optional) -------------------------

# GCP_PROJECT_ID turns publishing on once both service accounts are set. Use
# Application Default Credentials or inject the server credential yourself.
#GCP_PROJECT_ID=my-project
#GCP_REGION=us-central1
#GCP_SOURCE_BUCKET=my-project-app-sources
#GCP_ARTIFACT_REGISTRY=us-central1-docker.pkg.dev/my-project/user-apps
#GCP_SERVICE_ACCOUNT_EMAIL=
#CLOUD_RUN_SERVICE_ACCOUNT=
#CLOUD_RUN_MAX_INSTANCES=10
#CLOUD_RUN_MIN_INSTANCES=0
#CLOUD_RUN_MEMORY=512Mi
#CLOUD_RUN_CPU=1

# --- Custom publication URLs via Cloudflare Workers KV (Optional) -----------

# Set all four together. The Worker routes <name>.<base-domain>.
# Secret.
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_KV_NAMESPACE_ID=
#CLOUDFLARE_BASE_DOMAIN=

# --- Personal social connections (Optional) ---------------------------------

# Use your own provider apps. Keep each platform off until its app is ready.
#SOCIAL_ENABLED_PLATFORMS=x
#SOCIAL_CALLBACK_ORIGIN=https://zenith.example.com
# Secret. Stable base64 of 32 bytes (openssl rand -base64 32).
#SOCIAL_TOKEN_ENCRYPTION_KEY=
#SOCIAL_X_CLIENT_ID=
# Secret.
#SOCIAL_X_CLIENT_SECRET=
#SOCIAL_FACEBOOK_CLIENT_ID=
# Secret.
#SOCIAL_FACEBOOK_CLIENT_SECRET=
#SOCIAL_INSTAGRAM_CLIENT_ID=
# Secret.
#SOCIAL_INSTAGRAM_CLIENT_SECRET=
#SOCIAL_LINKEDIN_CLIENT_ID=
# Secret.
#SOCIAL_LINKEDIN_CLIENT_SECRET=
#SOCIAL_META_GRAPH_VERSION=v23.0

# --- Advanced tuning (Optional; defaults shown) ------------------------------

# Scheduler workers, sweep interval, and the database pool are set in
# docker-compose.production.yml, which overrides values here; tune them there.
# Workers must be at most one third of APP_DATABASE_MAX_CONNS.
#APP_SCHEDULE_WORKERS=8
#APP_SCHEDULE_SWEEP_SECONDS=30

#APP_HTTP_ADDR=:8788
#APP_SHUTDOWN_TIMEOUT_SECONDS=15
# Above 1 makes APP_REDIS_URL mandatory and every replica must share storage.
#APP_API_REPLICAS=1
#APP_DATABASE_MAX_CONNS=25
#APP_DATABASE_MIN_CONNS=5
#APP_DATABASE_MAX_CONN_LIFETIME_SECONDS=3600
#APP_DATABASE_MAX_CONN_IDLE_TIME_SECONDS=1800
#APP_DATABASE_HEALTH_CHECK_PERIOD_SECONDS=60
# Secret. Bearer token for /health/realtime from outside this machine.
#APP_REALTIME_METRICS_TOKEN=
# Refuse daemon requests that carry no daemon ID.
#APP_DAEMON_ID_REQUIRED=false
# A fixed nonzero UUID that keeps Studio receipt IDs stable across restores.
#APP_STUDIO_RECEIPT_NAMESPACE=
#AUTH_ACCESS_TOKEN_TTL_SECONDS=900
#AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
# Defaults to true whenever an HTTPS origin is configured.
#AUTH_COOKIE_SECURE=
#GOOGLE_OAUTH_FLOW_TTL_SECONDS=600
#GOOGLE_OAUTH_PROVIDER_TIMEOUT_SECONDS=10
# s3 (default) or local; local is for APP_ENVIRONMENT=local only.
#STORAGE_DRIVER=s3
# Secret. Only for temporary S3 credentials.
#STORAGE_S3_SESSION_TOKEN=
