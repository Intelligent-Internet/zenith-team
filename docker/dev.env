# Zenith Team local development environment — sourced by `make server`.
#
# Dev-only, non-secret credentials that mirror docker/compose.yml. Never reuse
# these values outside local development. Host ports can be remapped with the
# APP_*_PORT variables documented in docker/README.md; if you remap a port,
# update the matching URL below. The full environment reference (grouped by the
# APP_/AUTH_/STORAGE_/GOOGLE_/ATTACHMENT_ prefixes) lives in
# deploy/README.md.

# --- Application ------------------------------------------------------------
APP_NAME='Zenith Team API'
APP_ENVIRONMENT='local'

# --- Database + cache (docker/compose.yml) ----------------------------------
APP_DATABASE_URL='postgresql://boardly:boardly@localhost:5432/boardly?sslmode=disable'
APP_REDIS_URL='redis://localhost:6379/0'

# --- Huddles: calls, screen sharing, voice Agents (docs/huddles-local.md) ----
# Off by default. To turn them on, put HUDDLES_ENABLED='true' in
# docker/dev.local.env (ignored by git), then `make infra-up` (it starts LiveKit)
# and `make server`.
HUDDLES_ENABLED='false'

# --- LiveKit (started by `make infra-up` while Huddles are on) ---------------
# Keys match docker/livekit.docker.yaml and docker/livekit.dev.yaml.
LIVEKIT_URL='http://127.0.0.1:7880'
LIVEKIT_API_KEY='devkey'
LIVEKIT_API_SECRET='development-only-livekit-api-secret'

# --- Voice Agents in Huddles (local worker: `make voice-start`) -------------
# The workload secret must match voice-agent/.env (copied from .env.example).
HUDDLE_AI_ENABLED='true'
HUDDLE_AI_WORKLOAD_SECRET='development-only-huddle-ai-workload-secret'

# --- Token signing (must be >= 32 bytes; dev-only value) --------------------
AUTH_CSRF_SECRET='development-only-32-byte-secret!'

# --- Browser origins allowed to call the API --------------------------------
# The web dev server serves the app at :5173; loopback HTTP is accepted in dev.
AUTH_WEB_ORIGINS='http://localhost:5173,http://127.0.0.1:5173'
AUTH_WEB_APP_ORIGIN='http://localhost:5173'

# --- Email authentication (optional; keep real secrets out of this file) ----
# AUTH_EMAIL_PROVIDER='resend'
# AUTH_RESEND_API_KEY='<inject from your shell>'
# AUTH_EMAIL_VERIFICATION_SECRET='<inject >=32 bytes from your shell>'
# AUTH_EMAIL_VERIFICATION_TEMPLATE_ID='00000000-0000-4000-8000-000000000001'
# AUTH_EMAIL_VERIFICATION_TTL_SECONDS='600'
# AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS='60'
# AUTH_EMAIL_PROVIDER_TIMEOUT_SECONDS='10'
# AUTH_PASSWORD_RESET_TEMPLATE_ID='00000000-0000-4000-8000-000000000002'
# AUTH_PASSWORD_RESET_TTL_SECONDS='1800'
# AUTH_PASSWORD_RESET_RESEND_COOLDOWN_SECONDS='60'

# --- Company Mailbox (optional; dedicated Resend team/key) ------------------
# MAILBOX_RESEND_API_KEY='<inject from your shell>'
# Optional at startup; required before testing inbound delivery.
# MAILBOX_RESEND_WEBHOOK_SECRET='<inject whsec_ value from your shell>'
# MAILBOX_DOMAIN='mail.example.com'
# MAILBOX_REQUESTS_PER_SECOND='4'
# MAILBOX_PROVIDER_TIMEOUT_SECONDS='10'

# --- Google OAuth (optional; configure Web, Desktop, or both) ----------------
# GOOGLE_WEB_CLIENT_ID='<from Google Cloud console>'
# GOOGLE_WEB_CLIENT_SECRET='<inject from your shell>'
# GOOGLE_WEB_REDIRECT_URI='http://127.0.0.1:8788/api/v1/auth/google/web/callback'
# GOOGLE_DESKTOP_CLIENT_ID='<must differ when Web is also configured>'
# GOOGLE_DESKTOP_CLIENT_SECRET='<inject from your shell>'

# --- Output publication to Google Cloud Run (optional) ----------------------
# Reuse the reference architecture's values by exporting them before `make
# server`; do not commit Google credentials here. GCP_PROJECT_ID plus both
# dedicated service-account identifiers enable the worker.
# GCP_PROJECT_ID='boardly-production'
# GCP_REGION='asia-southeast1'
# GCP_SOURCE_BUCKET='boardly-app-sources'
# GCP_ARTIFACT_REGISTRY='asia-southeast1-docker.pkg.dev/boardly-production/user-apps'
# GCP_SERVICE_ACCOUNT_EMAIL='<required dedicated Cloud Build service account email>'
# CLOUD_RUN_SERVICE_ACCOUNT='<required dedicated runtime service account email>'

# --- Attachment storage → Silo (S3-compatible) ------------------------------
STORAGE_DRIVER='local'
STORAGE_S3_BUCKET='boardly-attachments'
STORAGE_S3_REGION='us-east-1'
STORAGE_S3_ENDPOINT='http://localhost:9000'
STORAGE_S3_ACCESS_KEY_ID='boardly'
STORAGE_S3_SECRET_ACCESS_KEY='boardly-development-secret'
STORAGE_S3_USE_PATH_STYLE='true'

# --- Custom publication URLs via Cloudflare Workers KV (optional) ---
# Configure all four values together. The Worker routes <name>.<base-domain>.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_BASE_DOMAIN=
